# Python / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
*.log

# Secrets / environment files
.env
**/.env
.env.local

# Virtualenvs / dependencies
**/.venv/
**/venv/
node_modules/

# Machine-specific environment config
# 可选 workspace 层覆盖（机器级配置请写机器层 ~/.config/ai-system/env.yaml）；
# 位于仓库内且被忽略 → 可能被仓库级清理误删（2026-09-24 事故）
config/environments/local.yaml
config/environments/context.yaml
config/environments/wsl.yaml

# Runtime state (wizard state, generated snapshots)
workspaces/.aic-state.yaml
# logs/ 与 metrics/ 均为历史位置（2026-09-24 已迁至工作区层 <workspace>/{logs,metrics}/，仓库外）；
# 保留忽略仅为防回归；仓库内再出现这两个目录即属异常（见 config/protected-paths.yaml）
logs/
metrics/
.ai-system/generated/

# OS
.DS_Store

# eclipse JDT 干跑 gate（C2）编译产物
tools/jdt-format-gate/build/
