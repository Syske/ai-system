# 本地环境配置模板。
#
# 机器相关配置默认走机器层 ~/.config/ai-system/env.yaml（首启由 tools/setup.py
# 按系统检测生成，各平台各一份互不覆盖；特殊情况用户自行编辑）。
# 本文件（workspace 层）仅在需要覆盖工作区级共享项时使用：
# 复制为 local.yaml 后按需填写；布局路径自动推导，无需改。
# 读取合并顺序：机器层（home）优先 → 本文件兜底 → 自动推导。

workspace:
  # root: 自动推导（ai-system 根的上层）；如确需覆盖可在此显式填写
  # repository_root: 自动推导（root/projects）

build:
  java_home: ""            # 本机 JDK 路径（Windows: D:\tools\java\jdk8；WSL/Linux: /mnt/d/tools/java/jdk8 或 /usr/lib/jvm/...）
  maven_home: ""           # 本机 Maven 路径
  maven_settings: ""       # 可选：maven settings.xml 路径
  # 编译后端: maven(默认, CLI) | idea(IDEA MCP 常驻编译, 需本机 IDEA + MCP Server 已启用)
  backend: maven
  # IDEA 编译后端配置(backend=idea 时生效)
  idea:
    executable: ""         # IDEA idea64.exe 路径（各人版本/路径不同，必须按本机配置）
    port: 64342

bugfix:
  # bugfix 运行模式: standard(默认, 纯诊断修复) | hotfix(现网问题, master 基线, 走完整发布前链路)
  mode: hotfix

layers:
  ai_system:
    description: AI Operating System core
  projects:
    description: all code repository
  methodologies:
    description: governance standards, openspec, specs, contracts
  skills:
    description: company/platform skill extensions (not auto-scanned by agents)
  company_standards:
    # 公司特有规范根（P31）——缺省 workspace/extensions/company-standards；
    # 需覆盖时填写绝对路径
    # path: ""
