#!/usr/bin/env bash
# Pre-commit gate shim → Python body (tools/pre_commit_gate.py).
# The shim only probes the interpreter and execs the Python body, which runs
# the actual gates (language Rule 4 + workflow↔runtime contract consistency).
#
# Why a shim: Unix ships python3, Windows Python ships only python.exe — a
# single shebang cannot cover both. bash itself is always available (native on
# Unix/macOS, Git-Bash ships with Git for Windows), so this shim runs everywhere.
#
# Escape hatch (documented, accepted tradeoff): `git commit --no-verify`.
# Enable for new clones: `git config core.hooksPath .githooks` (from repo root).
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
    echo "pre-commit: not inside a git repo" >&2
    exit 1
fi

py="$(command -v python3 || command -v python || true)"
if [ -z "$py" ]; then
    echo "pre-commit: python3/python not found in PATH" >&2
    exit 1
fi

exec "$py" "$repo_root/tools/pre_commit_gate.py" "$@"
